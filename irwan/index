<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Irwan Saputra — Digital Marketing Specialist</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Open+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --ink:      #1c1a18;
    --charcoal: #3a3835;
    --warm-mid: #7a7570;
    --warm-lt:  #b0aaa3;
    --rule:     #ddd8d0;
    --paper:    #f9f7f4;
    --white:    #ffffff;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }

  body {
    font-family: 'Open Sans', sans-serif;
    background: var(--white);
    color: var(--ink);
    overflow-x: hidden;
  }

  /* ── SCROLLBAR ── */
  ::-webkit-scrollbar { width: 3px; }
  ::-webkit-scrollbar-track { background: var(--paper); }
  ::-webkit-scrollbar-thumb { background: var(--rule); }

  /* ── NAV ── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.4rem 4rem;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s;
  }
  nav.scrolled { border-color: var(--rule); }

  .nav-logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.05rem;
    font-weight: 500;
    font-style: italic;
    color: var(--ink);
    letter-spacing: 0.04em;
  }
  .nav-links {
    display: flex;
    gap: 3rem;
    list-style: none;
  }
  .nav-links a {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--warm-mid);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--ink); }

  .btn-dl {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    background: none;
    color: var(--ink);
    border: 1px solid var(--ink);
    padding: 0.55rem 1.3rem;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .btn-dl:hover { background: var(--ink); color: var(--white); }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .hamburger span {
    display: block; width: 22px; height: 1.5px;
    background: var(--ink);
    transition: all 0.3s;
  }
  .hamburger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  .mobile-menu {
    display: none;
    position: fixed;
    inset: 0;
    background: var(--white);
    z-index: 99;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2.8rem;
  }
  .mobile-menu.open { display: flex; }
  .mobile-menu a {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    font-style: italic;
    color: var(--ink);
    text-decoration: none;
  }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 8rem 2rem 5rem;
    text-align: center;
    position: relative;
  }

  /* top ornament */
  .hero-ornament {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
    opacity: 0;
    animation: fadeUp 1s 0.2s forwards;
  }
  .hero-ornament-line {
    width: 40px; height: 1px;
    background: var(--rule);
  }
  .hero-ornament-text {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--warm-lt);
  }

  .photo-wrap {
    width: 120px; height: 120px;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--rule);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 2.5rem;
    opacity: 0;
    animation: fadeUp 1s 0.35s forwards;
    position: relative;
    overflow: hidden;
  }
  .photo-placeholder { font-size: 2.8rem; color: var(--rule); }

  .hero-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(3.2rem, 9vw, 6.5rem);
    font-weight: 300;
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--ink);
    margin-bottom: 0.6rem;
    opacity: 0;
    animation: fadeUp 1s 0.45s forwards;
  }
  .hero-name em {
    font-style: italic;
    font-weight: 300;
  }

  .hero-rule {
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-content: center;
    margin: 1.2rem 0;
    opacity: 0;
    animation: fadeUp 1s 0.55s forwards;
  }
  .hero-rule-line { width: 60px; height: 1px; background: var(--rule); }
  .hero-rule-diamond {
    width: 5px; height: 5px;
    background: var(--warm-lt);
    transform: rotate(45deg);
  }

  .hero-title {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--warm-mid);
    margin-bottom: 2rem;
    opacity: 0;
    animation: fadeUp 1s 0.65s forwards;
  }

  .hero-summary {
    max-width: 520px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.15rem;
    font-weight: 400;
    font-style: italic;
    line-height: 1.85;
    color: var(--warm-mid);
    margin: 0 auto 2.5rem;
    opacity: 0;
    animation: fadeUp 1s 0.75s forwards;
  }

  .hero-contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    justify-content: center;
    opacity: 0;
    animation: fadeUp 1s 0.85s forwards;
  }
  .contact-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--charcoal);
    text-decoration: none;
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--rule);
    transition: border-color 0.2s, color 0.2s;
  }
  .contact-pill:hover { border-color: var(--ink); color: var(--ink); }

  .hero-scroll {
    position: absolute;
    bottom: 2.5rem; left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    opacity: 0;
    animation: fadeIn 1.2s 1.2s forwards;
  }
  .hero-scroll span {
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--warm-lt);
  }
  .scroll-line {
    width: 1px; height: 36px;
    background: linear-gradient(to bottom, var(--rule), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  /* ── SECTION BASE ── */
  section { padding: 6rem 2rem; }
  .container { max-width: 820px; margin: 0 auto; }

  .section-head {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }
  .section-head-line { flex: 1; height: 1px; background: var(--rule); }
  .section-label-outer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }
  .s-tag {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--warm-lt);
  }
  .s-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 400;
    font-style: italic;
    color: var(--ink);
    letter-spacing: 0.02em;
  }

  /* ── ACHIEVEMENTS ── */
  #achievements { background: var(--paper); }
  .ach-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0;
    border: 1px solid var(--rule);
  }
  .ach-card {
    padding: 2.2rem 1.8rem;
    border-right: 1px solid var(--rule);
    transition: background 0.2s;
  }
  .ach-card:last-child { border-right: none; }
  .ach-card:hover { background: var(--white); }
  .ach-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.8rem;
    font-weight: 300;
    color: var(--ink);
    line-height: 1;
    margin-bottom: 0.6rem;
  }
  .ach-num sup { font-size: 1.1rem; }
  .ach-desc {
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--warm-mid);
    font-weight: 400;
  }

  /* ── EXPERIENCE ── */
  .xp-list { display: flex; flex-direction: column; gap: 0; }
  .xp-item {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 0 3rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--rule);
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s, transform 0.6s;
  }
  .xp-item:first-child { border-top: 1px solid var(--rule); }
  .xp-item.visible { opacity: 1; transform: translateY(0); }

  .xp-left {}
  .xp-period {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--warm-lt);
    margin-bottom: 0.3rem;
    line-height: 1.4;
  }
  .xp-loc {
    font-size: 0.72rem;
    color: var(--warm-lt);
    font-style: italic;
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.9rem;
  }

  .xp-right {}
  .xp-role {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 0.2rem;
    line-height: 1.2;
  }
  .xp-company {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--warm-mid);
    margin-bottom: 1rem;
    text-transform: uppercase;
  }
  .xp-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .xp-bullets li {
    font-size: 0.83rem;
    color: var(--charcoal);
    line-height: 1.65;
    padding-left: 1rem;
    position: relative;
  }
  .xp-bullets li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--warm-lt);
    font-size: 1.1rem;
    line-height: 1.4;
  }

  /* ── SKILLS ── */
  #skills { background: var(--white); }
  .skills-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem 4rem;
  }
  .skill-group-title {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--warm-lt);
    margin-bottom: 1.2rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--rule);
  }
  .skill-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .skill-item {
    font-size: 0.82rem;
    color: var(--charcoal);
    font-weight: 400;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .skill-item::before {
    content: '';
    display: inline-block;
    width: 12px; height: 1px;
    background: var(--rule);
    flex-shrink: 0;
  }

  .lang-wrap {
    grid-column: 1 / -1;
  }
  .lang-items {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .lang-item {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    font-style: italic;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .lang-item::after {
    content: '';
    display: inline-block;
    width: 3px; height: 3px;
    background: var(--rule);
    border-radius: 50%;
    margin-left: 1rem;
  }
  .lang-item:last-child::after { display: none; }

  /* ── PORTFOLIO ── */
  #portfolio { background: var(--paper); }
  .port-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .port-card {
    background: var(--white);
    display: block;
    text-decoration: none;
    padding: 2.5rem 2rem;
    transition: background 0.25s;
    position: relative;
    overflow: hidden;
  }
  .port-card:hover { background: var(--ink); }

  .port-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 3.5rem;
    font-weight: 300;
    color: var(--rule);
    line-height: 1;
    margin-bottom: 1.5rem;
    transition: color 0.25s;
  }
  .port-card:hover .port-num { color: rgba(255,255,255,0.15); }

  .port-icon-line {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.8rem;
  }
  .port-icon { font-size: 1.4rem; }
  .port-arrow {
    margin-left: auto;
    width: 28px; height: 28px;
    border: 1px solid var(--rule);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }
  .port-card:hover .port-arrow {
    background: rgba(255,255,255,0.15);
    border-color: rgba(255,255,255,0.3);
    transform: rotate(45deg);
  }
  .port-arrow svg { width: 12px; height: 12px; }
  .port-arrow svg path { stroke: var(--warm-lt); transition: stroke 0.2s; }
  .port-card:hover .port-arrow svg path { stroke: var(--white); }

  .port-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 0.3rem;
    transition: color 0.25s;
  }
  .port-card:hover .port-title { color: var(--white); }

  .port-sub {
    font-size: 0.72rem;
    color: var(--warm-lt);
    letter-spacing: 0.06em;
    transition: color 0.25s;
  }
  .port-card:hover .port-sub { color: rgba(255,255,255,0.5); }

  /* ── EDUCATION ── */
  #education { background: var(--white); }
  .edu-wrap {
    display: flex;
    align-items: flex-start;
    gap: 3rem;
    padding: 2.5rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .edu-year-block {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.9rem;
    font-style: italic;
    color: var(--warm-lt);
    min-width: 120px;
    padding-top: 0.2rem;
    line-height: 1.4;
  }
  .edu-degree {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.6rem;
    font-weight: 400;
    font-style: italic;
    color: var(--ink);
    margin-bottom: 0.3rem;
    line-height: 1.2;
  }
  .edu-school {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--warm-mid);
  }

  /* ── FOOTER ── */
  footer {
    padding: 3rem 2rem;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    font-style: italic;
    color: var(--ink);
  }
  .footer-copy {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: var(--warm-lt);
    text-transform: uppercase;
  }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; } to { opacity: 1; }
  }
  @keyframes scrollPulse {
    0%,100% { opacity: 0.3; }
    50%      { opacity: 1; }
  }

  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    nav { padding: 1.2rem 1.5rem; }
    .nav-links, .btn-dl { display: none; }
    .hamburger { display: flex; }

    section { padding: 4rem 1.5rem; }

    .xp-item { grid-template-columns: 1fr; gap: 0.5rem; }
    .xp-left { display: flex; gap: 1rem; align-items: baseline; flex-wrap: wrap; }

    .skills-wrap { grid-template-columns: 1fr; gap: 2rem; }
    .lang-wrap { grid-column: auto; }

    .port-grid { grid-template-columns: 1fr; }

    .edu-wrap { flex-direction: column; gap: 1rem; }

    footer { flex-direction: column; align-items: flex-start; }
  }

  @media (max-width: 480px) {
    .ach-grid { grid-template-columns: 1fr 1fr; }
    .ach-card:nth-child(2) { border-right: none; }
    .ach-card:nth-child(1),
    .ach-card:nth-child(2) { border-bottom: 1px solid var(--rule); }
  }

  @media print {
    nav, .hero-scroll, footer .btn-dl, .hamburger { display: none !important; }
    section { padding: 2rem 1rem; }
    .hero { min-height: auto; padding-top: 2rem; }
    * { animation: none !important; opacity: 1 !important; transform: none !important; }
  }
</style>
</head>
